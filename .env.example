# 复制为 .env 用于本地开发；线上请在 Netlify 后台 Site configuration > Environment variables 中配置，切勿提交到仓库

# 每个接收人一个访问码（标签:访问码），逗号分隔。删除某一项即可单独吊销
ACCESS_CODES=friendA:CHANGE-ME-8f2k-Q9xz,friendB:CHANGE-ME-p3Lm-7vTa

# OpenAI 兼容接口（OpenAI / DeepSeek / 通义 / Kimi / 智谱 / SiliconFlow 等）
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat
# 服务商不支持 response_format=json_object 时设为 off
LLM_JSON_MODE=on

# 每个访问码每日 AI 调用上限（自带 Key 不计入）
DAILY_QUOTA=30

# 只允许你自己的站点调用 API（部署后填写，逗号分隔）
ALLOWED_ORIGINS=

# 构建时前端 JS 域名锁定（部署后填写，如 your-site.netlify.app）
DOMAIN_LOCK=
